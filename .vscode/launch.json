{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CBCT (selected CMake preset, Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--config",
        "${input:configPath}",
        "--backend",
        "${input:backend}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "configPath",
      "type": "promptString",
      "description": "Path to the reconstruction config.json",
      "default": "data/amazon_cast/config.json"
    },
    {
      "id": "backend",
      "type": "pickString",
      "description": "Reconstruction backend (must be enabled in the selected CMake preset)",
      "options": [
        "auto",
        "cpu",
        "cuda",
        "vulkan"
      ],
      "default": "auto"
    }
  ]
}
